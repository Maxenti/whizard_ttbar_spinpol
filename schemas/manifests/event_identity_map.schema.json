{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event identity map",
  "type": "object",
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "global_event_id",
          "sample_id",
          "exact_subprocess_id",
          "shard_id",
          "generator_event_number"
        ]
      }
    }
  }
}
