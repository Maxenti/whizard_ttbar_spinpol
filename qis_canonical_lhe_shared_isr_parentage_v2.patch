+def normalize_isr_photon_mothers(particles: list[Particle]) -> int:
+    """Give explicit ISR photons the shared incoming-pair ancestry.
+
+    After removing WHIZARD's post-ISR bridge leptons, the top pair and the two
+    ISR photons are all direct products of the nominal incoming lepton pair.
+    Leaving each photon attached to only one beam makes each incoming
+    particle's daughter set non-contiguous in the event record:
+
+      beam 1 -> {t, tbar, gamma_1}
+      beam 2 -> {t, tbar, gamma_2}
+
+    PYTHIA represents daughter relations as index ranges, so those sets imply
+    ranges that accidentally include the other beam's photon and fail the
+    event consistency check.  Assigning both incoming particles as the
+    mothers of each explicit ISR photon yields the canonical 2 -> ttbar+gamma
+    hard-system genealogy while leaving all four-vectors untouched.
+    """
+
+    incoming_indices = [
+        index
+        for index, particle in enumerate(particles, start=1)
+        if particle.status == -1
+    ]
+    if len(incoming_indices) != 2:
+        raise CanonicalizationError(
+            "cannot normalize ISR photon ancestry without exactly two incoming particles"
+        )
+
+    incoming_pair = tuple(sorted(incoming_indices))
+    rewired = 0
+
+    for particle in particles:
+        if particle.status != 1 or particle.pid != 22:
+            continue
+
+        nonzero_mothers = {
+            mother
+            for mother in (particle.mother1, particle.mother2)
+            if mother != 0
+        }
+        if len(nonzero_mothers) != 1:
+            continue
+        if not nonzero_mothers.issubset(set(incoming_pair)):
+            continue
+
+        particle.mother1 = incoming_pair[0]
+        particle.mother2 = incoming_pair[1]
+        rewired += 1
+
+    return rewired
+
+
+def validate_contiguous_daughter_ranges(
+    particles: list[Particle],
+    *,
+    event_number: int,
+) -> None:
+    """Require each parent's explicit daughter indices to form one range.
+
+    PYTHIA stores daughter relationships as inclusive first/last index ranges.
+    A non-contiguous child set therefore cannot be represented without
+    accidentally claiming unrelated particles as daughters.
+    """
+
+    children_by_parent: dict[int, list[int]] = {
+        index: [] for index in range(1, len(particles) + 1)
+    }
+
+    for child_index, particle in enumerate(particles, start=1):
+        parents = {
+            mother
+            for mother in (particle.mother1, particle.mother2)
+            if mother != 0
+        }
+        for parent in parents:
+            children_by_parent[parent].append(child_index)
+
+    for parent, children in children_by_parent.items():
+        if not children:
+            continue
+        ordered = sorted(set(children))
+        expected = list(range(ordered[0], ordered[-1] + 1))
+        if ordered != expected:
+            raise CanonicalizationError(
+                f"event {event_number}: parent {parent} has non-contiguous "
+                f"daughters {ordered}; implied range would be {expected}"
+            )
+
