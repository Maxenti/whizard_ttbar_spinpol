===== EVENT_OUTPUT.INC =====
! Independent Phase-11 validation-event RNG.
# IMPORTANT:
# Do not reseed here.
#
# Phase-11C RNG-controller qualification demonstrated that the
# shard-defining RNG seed must be active before integrate(proc_epmum).
# The RNG state then continues into event generation.
simulate (proc_epmum) {
  n_events = 25000
  sample_format = lhef
  $sample = "phase11c_S0_11E_0004_seed311191004"
}
