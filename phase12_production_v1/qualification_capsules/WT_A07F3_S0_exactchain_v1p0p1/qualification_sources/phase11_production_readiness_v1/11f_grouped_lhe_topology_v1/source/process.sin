?resonance_history = true
resonance_on_shell_limit = 10
resonance_background_factor = 0

process proc_epmum =
  e1, E1 => E1, n1, b, e2, N2, bbar
  {$restrictions =
    "3+4~W+ && 6+7~W- && 3+4+5~t && 6+7+8~tbar"}

