===== EVENT_OUTPUT.INC =====
! Independent Phase-11 validation-event RNG.
# IMPORTANT:
# Do not reseed here.
#
# Phase-11C RNG-controller qualification demonstrated that the
# shard-defining RNG seed must be active before integrate(proc_epmum).
# The RNG state then continues into event generation.
simulate (proc_epmum) {
  n_events = 25000
  sample_format = lhef
  $sample = "phase11c_S0_NP4_SMOKE_25K_seed311190001"
}
MPI_RANKS=4
OMP_NUM_THREADS=1
WHIZARD_EXE=/afs/cern.ch/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/local/whizard-3.1.8-mpi-omp-qualified-20260811/bin/whizard
MPI_MERGER=/afs/cern.ch/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/phase11_production_readiness_v1/tools/np4_generation_v1/merge_mpi_lhe.py
LHE_LAYOUT=whizard_mpi_rank_merge
