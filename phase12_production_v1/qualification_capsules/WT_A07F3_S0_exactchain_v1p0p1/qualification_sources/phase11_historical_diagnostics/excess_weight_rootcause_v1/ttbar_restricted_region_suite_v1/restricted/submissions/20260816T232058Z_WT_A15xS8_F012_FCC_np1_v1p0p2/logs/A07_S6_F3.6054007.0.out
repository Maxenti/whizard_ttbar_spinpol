resonance_background_factor = 0

process proc_epmum = e1, E1 => b, bbar, E1, n1, e2, N2 {$restrictions = "5+6~W+ && 7+8~W- && 3+5+6~t && 4+7+8~tbar"}
include("common/integration.inc")
