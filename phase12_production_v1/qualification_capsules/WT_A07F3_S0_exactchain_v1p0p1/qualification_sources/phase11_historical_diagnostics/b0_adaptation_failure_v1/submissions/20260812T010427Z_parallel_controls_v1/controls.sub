universe = vanilla

executable = run_control.sh
arguments = $(mode) $(out_root)

output = logs/$(mode).$(ClusterId).$(ProcId).out
error  = logs/$(mode).$(ClusterId).$(ProcId).err
log    = logs/controls.$(ClusterId).log

request_cpus   = 1
request_memory = 3000MB
request_disk   = 6000MB

+JobFlavour = "tomorrow"

getenv = True
should_transfer_files = NO

queue mode,out_root from itemdata.tsv
