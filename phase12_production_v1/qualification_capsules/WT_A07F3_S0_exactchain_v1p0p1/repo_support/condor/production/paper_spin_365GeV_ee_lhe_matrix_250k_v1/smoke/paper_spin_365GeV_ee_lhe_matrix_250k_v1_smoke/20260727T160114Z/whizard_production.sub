# Generated into a concrete submit file by scripts/production/submit_production.py.
universe = vanilla
executable = /afs/cern.ch/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/scripts/production/run_production_shard.sh

arguments = \
  --sample-id $(sample_id) \
  --initial-state $(initial_state) \
  --decay-channel $(decay_channel) \
  --polarization $(polarization) \
  --shard-index $(shard_index) \
  --seed $(seed) \
  --events $(events) \
  --campaign-root /eos/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/production/paper_spin_365GeV_ee_lhe_matrix_250k_v1_smoke \
  --template $(template_basename) \
  --archive-workspace $(archive_workspace) \
  $(force_flag)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = $(template_path)
transfer_output_files = ""

request_cpus = $(request_cpus)
request_memory = $(job_memory_mb)MB

output = /afs/cern.ch/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/condor/production/paper_spin_365GeV_ee_lhe_matrix_250k_v1/smoke/paper_spin_365GeV_ee_lhe_matrix_250k_v1_smoke/20260727T160114Z/stdout/$(sample_id)/$(shard_label).$(ClusterId).$(ProcId).out
error  = /afs/cern.ch/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/condor/production/paper_spin_365GeV_ee_lhe_matrix_250k_v1/smoke/paper_spin_365GeV_ee_lhe_matrix_250k_v1_smoke/20260727T160114Z/stderr/$(sample_id)/$(shard_label).$(ClusterId).$(ProcId).err
log    = /afs/cern.ch/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/condor/production/paper_spin_365GeV_ee_lhe_matrix_250k_v1/smoke/paper_spin_365GeV_ee_lhe_matrix_250k_v1_smoke/20260727T160114Z/whizard_production.condor.log

getenv = False
environment = "PYTHONDONTWRITEBYTECODE=1;KEY4HEP_SETUP=/cvmfs/sw.hsf.org/key4hep/setup.sh"

+JobFlavour = "$(job_flavour)"
+JobBatchName = "whizard_365ee_250k_smoke_v1"

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = false

queue sample_id,initial_state,decay_channel,polarization,shard_index,shard_label,seed,events,template_path,template_basename,request_cpus,job_memory_mb,job_flavour,archive_workspace,force_flag from /afs/cern.ch/user/c/cglenn/FCCWork/whizard/whizard_ttbar_spinpol/condor/production/paper_spin_365GeV_ee_lhe_matrix_250k_v1/smoke/paper_spin_365GeV_ee_lhe_matrix_250k_v1_smoke/20260727T160114Z/jobs.itemdata
