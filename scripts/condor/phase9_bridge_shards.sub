universe = vanilla

executable = scripts/condor/run_phase9_bridge_shard_job.sh
arguments  = $(TTSP_REPO) $(TTSP_MANIFEST) $(ProcId) $(TTSP_OUT_TAG) $(TTSP_TIMEOUT_MINUTES)

output = $(TTSP_CONDOR_LOG_DIR)/stdout/job_$(ProcId).out
error  = $(TTSP_CONDOR_LOG_DIR)/stderr/job_$(ProcId).err
log    = $(TTSP_CONDOR_LOG_DIR)/condor.log

request_cpus   = 1
request_memory = 4096MB
request_disk   = 2048MB

+JobFlavour = "tomorrow"

getenv = False
should_transfer_files = NO

queue $(TTSP_N_JOBS)
