# Generated into a concrete submit file by scripts/production/submit_production.py.
universe = vanilla
executable = @EXECUTABLE@

arguments = \
  --sample-id $(sample_id) \
  --initial-state $(initial_state) \
  --decay-channel $(decay_channel) \
  --polarization $(polarization) \
  --shard-index $(shard_index) \
  --seed $(seed) \
  --events $(events) \
  --campaign-root @CAMPAIGN_ROOT@ \
  --template $(template_basename) \
  --archive-workspace $(archive_workspace) \
  $(force_flag)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = $(template_path)
transfer_output_files = ""

request_cpus = $(request_cpus)
request_memory = $(job_memory_mb)MB

output = @STDOUT_ROOT@/$(sample_id)/$(shard_label).$(ClusterId).$(ProcId).out
error  = @STDERR_ROOT@/$(sample_id)/$(shard_label).$(ClusterId).$(ProcId).err
log    = @SUBMISSION_LOG@

getenv = False
environment = "PYTHONDONTWRITEBYTECODE=1;KEY4HEP_SETUP=@KEY4HEP_SETUP@"

+JobFlavour = "$(job_flavour)"
+JobBatchName = "@BATCH_NAME@"

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = false

queue sample_id,initial_state,decay_channel,polarization,shard_index,shard_label,seed,events,template_path,template_basename,request_cpus,job_memory_mb,job_flavour,archive_workspace,force_flag from @JOBS_FILE@
