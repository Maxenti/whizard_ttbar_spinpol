+assert data["preparation"]["explicit_w_v3"]["total_events"] == 1
+assert data["preparation"]["explicit_w_v3"]["inserted_w_resonances"] == 2
+print(f"SHARDED WORKER SMOKE PASS: {path}")
+PY
